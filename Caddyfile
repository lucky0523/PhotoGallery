huoyi.dynv6.net {
    # 媒体文件由 Caddy 直接服务，路径需要手动指定
    handle_path /media/* {
        root * /home/ubuntu/docker_files/photo-gallery/data/dynamic
        file_server
        encode gzip zstd
    }

    # 其他所有请求（包括 /static/）都交给 Django
    handle {
        reverse_proxy localhost:8000
    }

    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    log {
        output file /var/log/caddy/photo-gallery.log
        format console
    }
}