    email lucky0523@gmail.com
    # debug  # 生产环境建议注释掉
}

huoyi.dynv6.net {

    # 静态文件 - Caddy 直接服务，不经过 Django
    handle_path /static/* {
		root * /srv/static
		file_server
		encode gzip zstd
	}

    # 媒体文件 - 用户上传的内容
	handle_path /media/* {
		root * /srv/media
		file_server
		encode gzip zstd
	}

    # 其余请求反向代理到 Django/uWSGI
    handle {
        reverse_proxy web:8000
    }

    # 响应压缩
    encode gzip zstd

    # 安全 Header
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # 日志
    log {
        output stderr
        format console
    }
}
